<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E0F2FF"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:elevation="4dp"
    android:layout_margin="26dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Flashcard"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#003366"
        android:fontFamily="@font/kulim_park_semibold"
        android:paddingBottom="12dp"/>

    <EditText
        android:id="@+id/etConcept"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Concept"
        android:fontFamily="@font/kulim_park_semibold"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        android:textColor="#000000"
        android:textColorHint="#666666"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Answer"
        android:fontFamily="@font/kulim_park"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        android:textColor="#000000"
        android:textColorHint="#666666"
        android:textSize="15sp"
        android:minLines="2"
        android:gravity="top|start"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnAddFlashcard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:fontFamily="@font/kulim_park_semibold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#003366"
        android:elevation="2dp"
        android:paddingVertical="10dp"/>

</LinearLayout>

